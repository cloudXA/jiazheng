APP_NAME=家政签约风控服务
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=example-change-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=mysql+asyncmy://example:example@127.0.0.1:3306/domestic_risk
AUTO_CREATE_TABLES=true

DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=example
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30

WECHAT_APP_ID=example
WECHAT_APP_SECRET=example
ASR_PROVIDER=mock
TENCENT_SECRET_ID=ID
TENCENT_SECRET_KEY=Key
TENCENT_ASR_REGION=ap-shanghai
TENCENT_ASR_ENGINE=16k_zh
TENCENT_ASR_TIMEOUT_SECONDS=20
TENCENT_ASR_HOTWORD_LIST=家政|5,保姆|5,阿姨|5,试工|5,服务费|5
CORS_ORIGINS=*

MYSQL_DATABASE=domestic_risk
MYSQL_HOST_PORT=3307
MYSQL_USER=example
MYSQL_PASSWORD=example
MYSQL_ROOT_PASSWORD=example
